# PickASparky Dashboard configuration (build-time: Vite inlines VITE_* values).
# Copy to `.env.local` for development.

# The API's public base URL, including /api/v1. The API must list this app's
# origin (e.g. http://localhost:5173) in its CORS_ORIGINS.
VITE_API_URL=http://localhost:8000/api/v1

# The public website, for "View profile" and "View page" links.
VITE_SITE_URL=http://localhost:3000